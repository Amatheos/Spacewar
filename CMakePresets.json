{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja",
      "displayName": "Ninja Debug",
      "description": "-O0, asserts on. Correctness work. Never profile this.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-reldbg",
      "displayName": "Ninja RelWithDebInfo (profiling)",
      "description": "-O2 -g. The build every measurement is taken on.",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build/ninja-reldbg",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "description": "-O3, no symbols. Shipping builds only.",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "ninja", "configurePreset": "ninja" },
    { "name": "ninja-reldbg", "configurePreset": "ninja-reldbg" },
    { "name": "ninja-release", "configurePreset": "ninja-release" }
  ]
}
